{
  "name": "verdura-pos",
  "private": true,
  "version": "0.1.0",
  "description": "POS para verdulería — monorepo: apps/web (Next.js) + apps/api (NestJS)",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "node scripts/run-app.mjs build",
    "seed": "pnpm --filter api seed",
    "start": "node scripts/run-app.mjs start"
  },
  "packageManager": "pnpm@10.13.1"
}
