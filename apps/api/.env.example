# Servidor
NODE_ENV=development
PORT=4000
TZ=America/Bogota

# MongoDB. Si MONGO_URL se deja vacío en desarrollo, la API levanta una
# base en memoria (mongodb-memory-server) y la llena con datos de ejemplo.
MONGO_URL=
MONGO_DB_NAME=verdura_pos

# CORS (separar por comas)
ALLOWED_ORIGINS=http://localhost:3000
