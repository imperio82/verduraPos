{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter api build",
    "watchPatterns": ["apps/api/**", "package.json", "pnpm-lock.yaml", "scripts/**"]
  },
  "deploy": {
    "startCommand": "pnpm --filter api start",
    "restartPolicyType": "ON_FAILURE"
  }
}
