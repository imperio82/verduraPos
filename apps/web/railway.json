{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter web build",
    "watchPatterns": ["apps/web/**", "package.json", "pnpm-lock.yaml", "scripts/**"]
  },
  "deploy": {
    "startCommand": "pnpm --filter web start",
    "restartPolicyType": "ON_FAILURE"
  }
}
